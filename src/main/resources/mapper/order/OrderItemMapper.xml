<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="io.github.takgeun.shop.order.infra.mybatis.OrderItemMapper">

    <resultMap id="orderItemsResultMap" type="io.github.takgeun.shop.order.domain.OrderItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productNameSnapshot" column="product_name_shot"/>
        <result property="unitPriceSnapshot" column="unit_price_snapshot"/>
        <result property="originalPriceSnapshot" column="original_price_snapshot"/>
        <result property="quantity" column="quantity"/>
        <result property="imageUrlSnapshot" column="image_url_snapshot"/>
    </resultMap>

    <sql id="orderItemsColumns">
        id,
        order_id,
        product_id,
        product_name_snapshot,
        unit_price_snapshot,
        original_price_snapshot,
        quantity,
        image_url_snapshot
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into order_items (
                                 order_id,
                                 product_id,
                                 product_name_snapshot,
                                 unit_price_snapshot,
                                 original_price_snapshot,
                                 quantity,
                                 image_url_snapshot
        ) values (
                  #{orderId},
                  #{productId},
                  #{productNameSnapshot},
                  #{unitPriceSnapshot},
                  #{originalPriceSnapshot},
                  #{quantity},
                  #{imageUrlSnapshot}
        )
    </insert>

    <select id="findAllByOrderId" resultMap="orderItemsResultMap">
        select
            <include refid="orderItemsColumns"></include>
        from order_items
        where order_id = #{orderId}
        order by id asc
    </select>

    <delete id="deleteByOrderId">
        delete from order_items
        where order_id = #{orderId}
    </delete>

    <delete id="deleteAll">
        delete from order_items
    </delete>
</mapper>